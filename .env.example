# Copy to .env.local for local development, and add the same values to your
# hosting provider (Vercel → Project → Settings → Environment Variables).
# Never commit real values.

# ── Site ─────────────────────────────────────────────────────────────────────
# Public address of the live site, used for canonical URLs, the sitemap and
# social sharing. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://ivorriscare.vercel.app

# Contact details shown across the site. Defaults (from the previous site) are
# used when these are left empty. The contact form and WhatsApp buttons send
# messages to NEXT_PUBLIC_WHATSAPP_NUMBER (country code, no + or spaces).
NEXT_PUBLIC_CONTACT_PHONE=+254705819115
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=+254 705 819 115
NEXT_PUBLIC_WHATSAPP_NUMBER=254705819115
NEXT_PUBLIC_CONTACT_EMAIL=carewithivorris@gmail.com

# ── Article dashboard (/admin) ───────────────────────────────────────────────
# SERVER ONLY. The password for signing in to the dashboard at /admin. At least
# 12 characters. Changing it signs everyone out. Never prefix with NEXT_PUBLIC_.
ADMIN_PASSWORD=

# SERVER ONLY. Set automatically when you connect a Vercel Blob store (public)
# to the project: newer stores set BLOB_STORE_ID, older ones
# BLOB_READ_WRITE_TOKEN. Either works. Stores articles and their images.
# Leave both empty locally: development saves to .data/ and public/uploads/.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# ── Intro video ───────────────────────────────────────────────────────────────
# Your own YouTube video for the floating video on the home page hero. Leave
# empty to show the default public explainer on care navigation (NHS).
NEXT_PUBLIC_INTRO_VIDEO_URL=
NEXT_PUBLIC_INTRO_VIDEO_TITLE=Ivorris Care in a minute

# ── Search engines ────────────────────────────────────────────────────────────
# Verification codes from Google Search Console and Bing Webmaster Tools
# ("HTML tag" method — paste only the content value, not the whole tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
