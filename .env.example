# Copy to .env.local for local development, and add the same values to your
# hosting provider (Vercel → Project → Settings → Environment Variables).
# Never commit real values.

# ── Site ─────────────────────────────────────────────────────────────────────
# Public address of the live site, used for canonical URLs, the sitemap and
# social sharing. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://ivorris-care.vercel.app

# Contact details shown across the site. Defaults (from the previous site) are
# used when these are left empty.
NEXT_PUBLIC_CONTACT_PHONE=+254705819115
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=+254 705 819 115
NEXT_PUBLIC_WHATSAPP_NUMBER=254705819115
NEXT_PUBLIC_CONTACT_EMAIL=carewithivorris@gmail.com

# ── Sanity CMS (blog) ────────────────────────────────────────────────────────
# From sanity.io/manage → your project. The blog shows an "articles on their
# way" message until these are set.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# SERVER ONLY. A Sanity API token with "Viewer" permissions — lets signed-in
# editors preview drafts. Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# SERVER ONLY. Any long random string; enter the same value as the secret on
# the Sanity webhook so published changes appear on the site immediately.
SANITY_REVALIDATE_SECRET=

# ── Contact form email (Resend) ──────────────────────────────────────────────
# SERVER ONLY. Without these the form tells visitors to call or WhatsApp
# instead — it never pretends a message was sent.
RESEND_API_KEY=
# Inbox(es) that receive enquiries. Separate several with commas.
CONTACT_TO_EMAIL=carewithivorris@gmail.com
# A sender on a domain verified in Resend, e.g. "Ivorris Website <website@yourdomain.com>".
CONTACT_FROM_EMAIL=
